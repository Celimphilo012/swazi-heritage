23062307,"present":0.016777803189070933,"throughout":0.01953606923062307,"attend":0.016777803189070933,"ani":0.01953606923062307,"unwel":0.01953606923062307}},{"type":"lineage","data":{"id":1,"title":"The Dlamini Royal Lineage","description":"The Dlamini clan is the royal clan of the Swazi nation and has been the ruling family of the Kingdom of Eswatini for centuries. The lineage traces back to Ngwane III, who led the Swazi people to settle in the present-day territory of Eswatini in the mid-18th century. Sobhuza I, also known as Somhlolo, consolidated the kingdom and is remembered for his famous vision of people of different races arriving in the land. The Dlamini lineage is central to Swazi identity, governance, and cultural ceremonies including the Incwala and Umhlanga.","era":"Pre-colonial era (before 1840)"},"vector":{"1840":0.04043175522612176,"dlamini":0.12129526567836527,"royal":0.035411236317165126,"lineag":0.08720606007705647,"pre":0.0470787242115015,"coloni":0.032057564672580925,"era":0.032057564672580925,"befor":0.032057564672580925,"clan":0.06411512934516185,"swazi":0.07305776143188693,"nation":0.026541626367315142,"rule":0.03571565567773191,"famili":0.04043175522612176,"kingdom":0.05813737338470432,"eswatini":0.08086351045224352,"centuri":0.094157448423003,"trace":0.0470787242115015,"back":0.0470787242115015,"ngwane":0.0470787242115015,"iii":0.0470787242115015,"who":0.03571565567773191,"led":0.04043175522612176,"peopl":0.07143131135546382,"settl":0.0470787242115015,"present":0.04043175522612176,"dai":0.04043175522612176,"territori":0.04043175522612176,"mid":0.0470787242115015,"18th":0.0470787242115015,"sobhuza":0.032057564672580925,"also":0.04043175522612176,"known":0.04043175522612176,"somhlolo":0.0470787242115015,"consolid":0.0470787242115015,"rememb":0.0470787242115015,"famou":0.0470787242115015,"vision":0.0470787242115015,"differ":0.0470787242115015,"race":0.0470787242115015,"arriv":0.04043175522612176,"land":0.032057564672580925,"central":0.0470787242115015,"ident":0.04043175522612176,"govern":0.03571565567773191,"cultur":0.032057564672580925,"ceremoni":0.02435258714396231,"includ":0.04043175522612176,"incwala":0.032057564672580925,"umhlanga":0.032057564672580925}},{"type":"lineage","data":{"id":2,"title":"The Sobhuza II Resistance Lineage","description":"This lineage documents the royal resistance led by King Sobhuza II against British colonial rule during the protectorate period. Sobhuza II ascended to the throne in 1921 and spent decades negotiating and fighting for Swazi land rights and sovereignty. He travelled to England to petition the British government regarding the land partition that had stripped the Swazi nation of two thirds of its territory. His persistence and diplomatic leadership preserved Swazi culture, traditions, and identity during one of the most difficult periods in the nation's history. The lineage connected to this era carries the burden and honour of having protected the kingdom through foreign occupation.","era":"Colonial period (1840–1968)"},"vector":{"1840":0.03332887930801929,"1921":0.03880813752569718,"1968":0.029441283734346575,"sobhuza":0.0792774910146258,"resist":0.06665775861603858,"lineag":0.07188607655000602,"coloni":0.0528516606764172,"period":0.08832385120303972,"document":0.03880813752569718,"royal":0.01459517172531806,"led":0.03332887930801929,"king":0.021878908221705726,"against":0.03880813752569718,"british":0.07761627505139436,"rule":0.029441283734346575,"dure":0.040148859885991914,"protector":0.03880813752569718,"ascend":0.03880813752569718,"throne":0.03880813752569718,"spent":0.03880813752569718,"decad":0.03880813752569718,"negoti":0.03880813752569718,"fight":0.03880813752569718,"swazi":0.06022328982898787,"land":0.0528516606764172,"right":0.03880813752569718,"sovereignti":0.03880813752569718,"travel":0.03332887930801929,"england":0.03880813752569718,"petit":0.03880813752569718,"govern":0.029441283734346575,"regard":0.03880813752569718,"partit":0.0388081375256971